{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      },
      "simulatorRoute": {
        "ClusterId": "simulatorCluster",
        "Match": {
          "Path": "/api/simulator/{**remainder}"
        },
        "Transforms": [ { "RequestHeaderRemove": "Origin" } ]
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "simulatorCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      }
    }
  }
}
